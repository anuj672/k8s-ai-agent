# Copy to .env for local development:  cp .env.example .env
# .env is git-ignored. Never commit real credentials.

# AWS identity for local runs (an IAM user or SSO profile, never root)
AWS_PROFILE=<your-aws-profile>
AWS_REGION=us-east-1

# Bedrock model (inference profile ID). Haiku for dev; swap to Sonnet for demos.
BEDROCK_MODEL_ID=global.anthropic.claude-haiku-4-5-20251001-v1:0

# Optional: Bedrock Guardrail for prompt-injection protection.
# Leave empty to run without it. Create one with a Prompt attack filter (High, Block),
# publish a version, then set both values.
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=1
