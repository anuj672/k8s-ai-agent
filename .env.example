# Copy to .env for local development:  cp .env.example .env
# .env is git-ignored. Never commit real credentials.

# AWS identity for local runs (an IAM user/SSO profile, never root)
AWS_PROFILE=anuj-admin
AWS_REGION=us-east-1

# Bedrock model (inference profile ID). Haiku for dev; swap to Sonnet for demos.
BEDROCK_MODEL_ID=