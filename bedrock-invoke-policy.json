{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "InvokeClaudeHaikuOnly",
      "Effect": "Allow",
      "Action": [
        "bedrock:InvokeModel",
        "bedrock:InvokeModelWithResponseStream"
      ],
      "Resource": [
        "arn:aws:bedrock:*:ACCOUNT_ID:inference-profile/global.anthropic.claude-haiku-4-5-*",
        "arn:aws:bedrock:*::foundation-model/anthropic.claude-haiku-4-5-*"
      ]
    },
    {
      "Sid": "ApplyOneGuardrail",
      "Effect": "Allow",
      "Action": "bedrock:ApplyGuardrail",
      "Resource": [
        "arn:aws:bedrock:us-east-1:ACCOUNT_ID:guardrail/GUARDRAIL_ID",
        "arn:aws:bedrock:*:ACCOUNT_ID:guardrail-profile/*"
      ]
    }
  ]
}
